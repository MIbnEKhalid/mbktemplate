<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{#if description}}{{description}}{{else}}{{appName}} — Built on the MBKTech Node.js ecosystem.{{/if}}">
  <title>{{title}}</title>
  
  <link rel="icon" type="image/svg+xml" href="/assets/images/icon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/assets/css/style.css">
  
  <script src="/assets/js/theme.js"></script>
</head>
<body class="{{#if isAdmin}}admin-body{{/if}}">

  {{#unless hideNav}}
  <!-- Global Navigation Header -->
  <header class="navbar">
    <div class="app-container">
      <div class="nav-wrapper">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <a href="/" class="brand-logo">
            <img src="/assets/images/icon.svg" alt="Logo" class="brand-icon">
            <div class="brand-logo-content">
              <span class="brand-title">{{appName}}</span>
              <span class="brand-subtitle">MBKTech Ecosystem</span>
            </div>
          </a>
          {{#if isAdmin}}
            <span class="badge badge-primary">Admin Area</span>
          {{/if}}
        </div>

        <nav class="nav-links">
          <a href="/" class="btn-ghost btn-sm">Home</a>
          <a href="/dashboard" class="btn-ghost btn-sm">Dashboard</a>
          <a href="/admin" class="btn-ghost btn-sm">Admin</a>
          <a href="/api/health" class="btn-ghost btn-sm" target="_blank">Health API</a>
        </nav>

        <div class="nav-actions">
          <button type="button" class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <i class="fa-solid fa-moon"></i>
          </button>
          
          {{#if userContext.userLoggedIn}}
            <span class="badge badge-success" title="Role: {{userContext.role}}">
              <i class="fa-solid fa-user-check" style="margin-right: 4px;"></i> {{userContext.username}}
            </span>
            <a href="/mbkauthe/logout" class="btn btn-secondary btn-sm" title="Sign Out">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <span>Logout</span>
            </a>
          {{else}}
            <a href="/mbkauthe/login" class="btn btn-primary btn-sm">
              <i class="fa-solid fa-arrow-right-to-bracket"></i>
              <span>Sign In</span>
            </a>
          {{/if}}
        </div>
      </div>
    </div>
  </header>
  {{/unless}}

  <!-- Main Body Content -->
  <main style="flex: 1; padding: 2rem 0;">
    {{{body}}}
  </main>

  <!-- Global Footer -->
  <footer class="app-footer">
    <div class="app-container">
      <div class="footer-content">
        <div>
          <strong>{{appName}}</strong> &copy; {{currentYear}} MBKTech.org. All rights reserved.
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
          <a href="https://github.com/MIbnEKhalid" target="_blank" class="btn-ghost btn-sm">
            <i class="fa-brands fa-github"></i> GitHub
          </a>
          <a href="https://mbktech.org" target="_blank" class="btn-ghost btn-sm">
            <i class="fa-solid fa-globe"></i> MBKTech.org
          </a>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>
