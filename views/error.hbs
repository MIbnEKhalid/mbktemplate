<div class="app-container" style="max-width: 620px; padding: 4rem 1.5rem; text-align: center;">
  <div class="card" style="padding: 3rem 2rem;">
    <div style="width: 64px; height: 64px; border-radius: var(--radius-sm); background: var(--color-danger-light); color: var(--color-danger); display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 1.25rem;">
      <i class="lni lni-warning"></i>
    </div>
    
    <h1 style="font-size: 1.85rem; font-weight: 700; margin-bottom: 0.75rem;">
      {{#if status}}{{status}} — {{/if}}Application Notice
    </h1>
    
    <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.6;">
      {{#if error}}{{error}}{{else}}We encountered an unexpected problem processing your request. Please try again or return home.{{/if}}
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">
        <i class="lni lni-home"></i> Return Home
      </a>
      <button onclick="window.history.back()" class="btn btn-secondary">
        <i class="lni lni-arrow-left"></i> Go Back
      </button>
    </div>
  </div>
</div>
