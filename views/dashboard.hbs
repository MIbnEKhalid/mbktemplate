<div class="app-container">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700;">User Dashboard</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        Welcome back, <strong>{{userContext.username}}</strong>! This view is protected with <code>sessPerm(Permissions.items.read)</code>.
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <a href="/admin" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-shield-halved"></i> Admin Area
      </a>
      <a href="/mbkauthe/logout" class="btn btn-ghost btn-sm">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
      </a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Create Item Form Card -->
    <div class="card">
      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem;">
        <i class="fa-solid fa-plus-circle" style="color: var(--primary);"></i> Add Item
      </h3>
      <form id="createItemForm" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem;">Item Name</label>
          <input type="text" id="itemName" name="name" required placeholder="e.g. Production Task #1" style="width: 100%; padding: 0.55rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-primary); color: var(--text-main);">
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem;">Description</label>
          <textarea id="itemDesc" name="description" rows="3" placeholder="Optional details..." style="width: 100%; padding: 0.55rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-primary); color: var(--text-main);"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          <i class="fa-solid fa-paper-plane"></i> Save Item
        </button>
      </form>
      <div id="formFeedback" style="margin-top: 1rem; font-size: 0.85rem; display: none;"></div>
    </div>

    <!-- Items Listing Table -->
    <div class="card">
      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem;">
        <i class="fa-solid fa-list-check" style="color: var(--accent);"></i> Recent Items
      </h3>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Created By</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="itemsTableBody">
            {{#if items.length}}
              {{#each items}}
                <tr id="item-row-{{this.id}}">
                  <td>#{{this.id}}</td>
                  <td>
                    <strong>{{this.name}}</strong>
                    {{#if this.description}}<div style="font-size: 0.75rem; color: var(--text-muted);">{{this.description}}</div>{{/if}}
                  </td>
                  <td>{{this.created_by}}</td>
                  <td><span class="badge badge-success">{{this.status}}</span></td>
                  <td>
                    <button class="btn btn-ghost btn-sm" onclick="deleteItem({{this.id}})" title="Delete Item">
                      <i class="fa-solid fa-trash" style="color: var(--danger);"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  No items found. Create your first item above!
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<script>
document.getElementById('createItemForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const feedback = document.getElementById('formFeedback');
  const name = document.getElementById('itemName').value;
  const description = document.getElementById('itemDesc').value;

  try {
    const res = await fetch('/api/items', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, description })
    });
    const result = await res.json();
    if (result.success) {
      feedback.style.display = 'block';
      feedback.style.color = 'var(--success)';
      feedback.textContent = 'Item created successfully! Refreshing...';
      setTimeout(() => window.location.reload(), 800);
    } else {
      feedback.style.display = 'block';
      feedback.style.color = 'var(--danger)';
      feedback.textContent = result.error?.message || result.error || 'Failed to create item';
    }
  } catch (err) {
    feedback.style.display = 'block';
    feedback.style.color = 'var(--danger)';
    feedback.textContent = err.message;
  }
});

async function deleteItem(id) {
  if (!confirm('Are you sure you want to delete this item?')) return;
  try {
    const res = await fetch(`/api/items/${id}`, { method: 'DELETE' });
    const result = await res.json();
    if (result.success) {
      const row = document.getElementById(`item-row-${id}`);
      if (row) row.remove();
    } else {
      alert(result.error?.message || 'Delete failed');
    }
  } catch (err) {
    alert(err.message);
  }
}
</script>
