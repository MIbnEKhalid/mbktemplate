<div class="app-container">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
        <span class="badge badge-primary"><i class="lni lni-user"></i> Active Session</span>
      </div>
      <h1 style="font-size: 1.85rem; font-weight: 700;">User Dashboard</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        Welcome back, <strong>{{userContext.username}}</strong>! Protected via <code>sessPerm(Permissions.items.read)</code>.
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/mbkbucket" class="btn btn-secondary btn-sm">
        <i class="lni lni-archive"></i> Storage
      </a>
      <a href="/admin" class="btn btn-secondary btn-sm">
        <i class="lni lni-shield"></i> Admin Area
      </a>
      <a href="/mbkauthe/logout" class="btn btn-ghost btn-sm">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
      </a>
    </div>
  </div>

  <div class="dashboard-grid">
    <!-- Create Item Form Card -->
    <div class="card">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <div style="width: 32px; height: 32px; border-radius: var(--radius-xs); background: var(--color-primary-light); color: var(--color-primary); display: flex; align-items: center; justify-content: center; font-size: 1rem;">
          <i class="lni lni-plus"></i>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700;">Create Item</h3>
      </div>

      <form id="createItemForm">
        <div class="form-group">
          <label class="form-label" for="itemName">Item Name</label>
          <input type="text" id="itemName" name="name" required placeholder="e.g. Production Task #1">
        </div>
        
        <div class="form-group">
          <label class="form-label" for="itemDesc">Description</label>
          <textarea id="itemDesc" name="description" rows="3" placeholder="Optional context or notes..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">
          <i class="lni lni-checkmark"></i> Save Item
        </button>
      </form>
      
      <div id="formFeedback" style="margin-top: 1rem; font-size: 0.85rem; padding: 0.6rem 0.85rem; border-radius: var(--radius-xs); display: none;"></div>
    </div>

    <!-- Items Listing Table -->
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <div style="width: 32px; height: 32px; border-radius: var(--radius-xs); background: var(--color-accent-light); color: var(--color-accent); display: flex; align-items: center; justify-content: center; font-size: 1rem;">
            <i class="lni lni-list"></i>
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700;">Recent Items</h3>
        </div>
        <span class="badge badge-neutral">{{items.length}} Total</span>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th style="width: 80px;">ID</th>
              <th>Name &amp; Details</th>
              <th>Creator</th>
              <th>Status</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody id="itemsTableBody">
            {{#if items.length}}
              {{#each items}}
                <tr id="item-row-{{this.id}}">
                  <td style="font-family: var(--font-mono); color: var(--text-muted);">#{{this.id}}</td>
                  <td>
                    <div style="font-weight: 600;">{{this.name}}</div>
                    {{#if this.description}}
                      <div style="font-size: 0.775rem; color: var(--text-muted); margin-top: 2px;">{{this.description}}</div>
                    {{/if}}
                  </td>
                  <td>
                    <span style="font-size: 0.85rem; color: var(--text-muted);"><i class="lni lni-user text-xs"></i> {{this.created_by}}</span>
                  </td>
                  <td>
                    <span class="badge badge-success"><i class="lni lni-checkmark text-xs"></i> {{this.status}}</span>
                  </td>
                  <td style="text-align: right;">
                    <button class="btn btn-ghost btn-sm" onclick="deleteItem({{this.id}})" title="Delete Item" style="color: var(--color-danger);">
                      <i class="lni lni-trash-can"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 3rem 1rem;">
                  <div style="font-size: 2rem; color: var(--text-subtle); margin-bottom: 0.5rem;">
                    <i class="lni lni-inbox"></i>
                  </div>
                  <div style="font-weight: 600;">No items found</div>
                  <div style="font-size: 0.825rem;">Create your first record using the form on the left!</div>
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<script>
document.getElementById('createItemForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const feedback = document.getElementById('formFeedback');
  const name = document.getElementById('itemName').value;
  const description = document.getElementById('itemDesc').value;

  try {
    const res = await fetch('/api/items', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, description })
    });
    const result = await res.json();
    if (result.success) {
      feedback.style.display = 'block';
      feedback.style.background = 'var(--color-success-light)';
      feedback.style.color = '#065f46';
      feedback.textContent = 'Item created successfully! Reloading...';
      setTimeout(() => window.location.reload(), 700);
    } else {
      feedback.style.display = 'block';
      feedback.style.background = 'var(--color-danger-light)';
      feedback.style.color = 'var(--color-danger)';
      feedback.textContent = result.error?.message || result.error || 'Failed to create item';
    }
  } catch (err) {
    feedback.style.display = 'block';
    feedback.style.background = 'var(--color-danger-light)';
    feedback.style.color = 'var(--color-danger)';
    feedback.textContent = err.message;
  }
});

async function deleteItem(id) {
  if (!confirm('Are you sure you want to delete this item?')) return;
  try {
    const res = await fetch(`/api/items/${id}`, { method: 'DELETE' });
    const result = await res.json();
    if (result.success) {
      const row = document.getElementById(`item-row-${id}`);
      if (row) row.remove();
    } else {
      alert(result.error?.message || 'Delete failed');
    }
  } catch (err) {
    alert(err.message);
  }
}
</script>
