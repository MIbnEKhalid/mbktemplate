{
  "name": "mbktemplate",
  "version": "1.0.0",
  "description": "Standard starter template project for the MBKTech Node.js ecosystem",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "sync_permissions": "node scripts/sync_permissions.js",
    "db:init:postgres": "node scripts/initDb.js --type=postgres",
    "db:init:sqlite": "node scripts/initDb.js --type=sqlite",
    "test": "vitest run"
  },
  "author": "Muhammad Bin Khalid",
  "license": "MIT",
  "dependencies": {
    "admindb": "latest",
    "better-sqlite3": "13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^8.7.0",
    "mbkauthe": "latest",
    "mbkbucket": "latest",
    "mbkutils": "latest",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
