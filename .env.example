# ==============================================================================
# MBKTech Template Application - Environment Variables
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Server Configuration
PORT=3080
BASE_URL=http://localhost:3080
NODE_ENV=development

# Database Configuration (Dual database: 'postgres' or 'sqlite')
DB_TYPE=sqlite
SQLITE_PATH=./data/app.db
# NEON_POSTGRES=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/mbk_db?sslmode=require

# MBK Authentication Configuration
# APP_NAME: Human-readable application name
# loginRedirectURL: Post-login destination
mbkautheVar={"APP_NAME":"MBKTemplate","loginRedirectURL":"/dashboard","CLI_AUTH_ENABLED":"false"}

# MBK Authentication Shared Settings
mbkauthShared={"Main_SECRET_TOKEN":12345,"DOMAIN":"localhost","IS_DEPLOYED":"false","DEVICE_TRUST_DURATION_DAYS":7,"SESSION_SECRET_KEY":"your-session-secret-change-in-production","DB_TYPE":"sqlite","LOGIN_DB":"./data/app.db","MBKAUTH_TWO_FA_ENABLE":"false","COOKIE_EXPIRE_TIME":2,"GITHUB_LOGIN_ENABLED":"false","GOOGLE_LOGIN_ENABLED":"false"}

# MBKBucket Storage Configuration (Local Disk, S3, Cloudflare R2, Google Drive)
# By default, local storage is used. Uncomment/customize as needed.
BucketConnection={"Local_Disk":{"type":"local","basePath":"./data/storage"}}
mbkbucketVar={"publiView_enabled":"true","p_view_inline":"true"}
